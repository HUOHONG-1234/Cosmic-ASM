#% lib/io.cos —— 文件读写库
#%
#% 实测结论：read_text / write_text 不能作为**用户函数参数**（函数参数只能是数值），
#% 因此不提供 file_bytes(path) 之类的包装函数，避免留下编不过的文件。
#%
#% 但 v8.1 起，返回文本的内置可以直接互相嵌套，两条后端一致：
#%   math_run strlen(read_text("index.json")) = ? -int64
#%   math_run find(read_text("a.txt"), "ERROR") = ? -int64
#%   math_run line_count(trim(read_text("a.txt"))) = ? -int64
#%
#% 需要多次查询同一份内容时，先读进变量更省：
#%   math_run read_text("index.json") = ?
#%   push ({TXT} = {(in = up)})
#%   math_run strlen({TXT}) = ? -int64                # 文件字节数
#%   math_run line_count({TXT}) = ? -int64            # 文件行数
#%   math_run find({TXT}, "ERROR") = ? -int64
#%
#% 注意 push 的值只能是字面量、变量或 (in = up)，因此
#%   push ({CONTENT} = read_text({PATH}))
#% 会被解析器拒绝；必须像上面那样先 math_run，再用 (in = up) 接结果。
#%
#% 写入（路径与内容同样只能是字符串字面量或 var 文本变量）：
#%   math_run write_text("out.txt", "content") = ? -int64
#%
#% 结论：本文件只保留说明，不定义函数，保证 include 后在两个后端都能通过。
