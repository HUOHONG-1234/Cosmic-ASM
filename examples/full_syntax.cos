#% ------------------------------------------------------------
#% 7. 记录（v7 引入，v9 起是一等值，v10 起字段可以是文本）
#% record Name { 字段, 字段 : text }
#% operator + Name = { 表达式, ... }  仅 + - * /，解析期静态展开
#% 记录可作参数、作返回值、在函数之间传递；字段读写用 name.field
#% ------------------------------------------------------------
record Point { x, y }
operator + Point = { left.x + right.x, left.y + right.y }
operator - Point = { left.x - right.x, left.y - right.y }

function add_points(a : Point, b : Point) -> Point = a + b
function point_norm(p : Point) = p.x * p.x + p.y * p.y

function record_demo()
{
    let base = Point(1, 2)
    let delta = Point(10, 20)
    let sum = base + delta
    let diff = delta - base
    let copy = sum
    set copy.x = 100
    return sum.x * 1000 + copy.x * 100 + diff.y
}
math_run record_demo() = ? -int64
if up = (ok) goto (push ({rec_demo} = {(in = up)}))
#% 记录也能直接作实参传入（Point(...) 就是构造表达式）
math_run point_norm(Point(3, 4)) = ? -int64
if up = (ok) goto (push ({rec_norm} = {(in = up)}))
function record_pair_demo()
{
    let a = Point(1, 2)
    let b = add_points(a, Point(10, 20))
    return b.x + b.y
}
math_run record_pair_demo() = ? -int64
if up = (ok) goto (push ({rec_pair} = {(in = up)}))
print (<{"record_demo="} (and) {rec_demo} (and) {" norm(3,4)="} (and) {rec_norm}>)
print (<{"add_points total="} (and) {rec_pair}>)

#% 文本字段：记录因此能装标识符、字面量这类内容（AST 节点就需要）
record Token { kind : text, text : text, line }
function token_label(t : Token) -> text
{
    return text_concat(text_concat(text_concat(t.kind, ":"), text_concat(t.text, "@")), to_text(t.line))
}
function token_demo() -> text
{
    let t = Token("let", "x", 3)
    let copy = t
    set copy.text = "y"
    return text_concat(token_label(t), text_concat(" / ", token_label(copy)))
}
math_run token_label(Token("num", "42", 7)) = ?
if up = (ok) goto (push ({tok1} = {(in = up)}))
math_run token_demo() = ?
if up = (ok) goto (push ({tok2} = {(in = up)}))
print (<{"token="} (and) {tok1}>)
print (<{"copy="} (and) {tok2}>)

#% ------------------------------------------------------------
#% 8. v10：函数体内 print、循环体内 var
#% 函数内 print 的文本形参需要标注 : text（print 不参与类型推断）
#% 循环体里的 var 每轮都是新绑定；顶层重复声明仍报错
#% ------------------------------------------------------------
function report(name : text, score)
{
    print (<{"  [report] "} (and) {name} (and) {" = "} (and) {score}>)
    return score
}
math_run report("ann", 95) = ? -int64
if up = (ok) goto (push ({reported} = {(in = up)}))
print (<{"report returned "} (and) {reported}>)

function loop_with_locals(times) -> text
{
    let acc = ""
    let i = 0
    while (i < times)
    {
        let stamp = text_concat("v", to_text(i))
        set acc = text_concat(acc, stamp)
        set i = i + 1
    }
    return acc
}
math_run loop_with_locals(3) = ?
if up = (ok) goto (push ({locals_out} = {(in = up)}))
print (<{"loop locals="} (and) {locals_out}>)

#% ------------------------------------------------------------
#% 9. 命名空间与别名
#% #%namespace = 名称 只作用于其后的函数；#%namespace = global 回到全局
#% 带命名空间的函数内部名是 名称__函数，调用要写 名称::函数(...) 或用 #%use 起别名
#% ------------------------------------------------------------
#%namespace = geometry
function area(w, h) = w * h
#%namespace = global
#%use = geometry.area as rect_area

math_run rect_area(3, 4) = ? -int64
if up = (ok) goto (push ({alias_area} = {(in = up)}))
math_run geometry::area(5, 6) = ? -int64
if up = (ok) goto (push ({qualified_area} = {(in = up)}))
print (<{"alias="} (and) {alias_area} (and) {" qualified="} (and) {qualified_area}>)

#% ------------------------------------------------------------
#% 10. 顶层错误处理：try / catch / finally（至少要有 catch 或 finally）
#% catch 接住「语言状态机层面」的错误；硬失败（除零、越界）不会被接住
#% ------------------------------------------------------------
try
{
    push ({risky} = {"attempted"})
}
catch
{
    push ({risky} = {"caught"})
}
finally
{
    push ({cleanup} = {"done"})
}
print (<{"try="} (and) {risky} (and) {" finally="} (and) {cleanup}>)

