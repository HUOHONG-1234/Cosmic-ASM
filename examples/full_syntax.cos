#% ------------------------------------------------------------
#% 12. 内存回收控制（编译版生效；解释器同样记录状态）
#% gc_pin 固定缓冲；The_world (stop|force|start) 暂停 / 立即释放 / 恢复
#% ------------------------------------------------------------
array pinned_data = [1, 2, 3]
gc_pin ({pinned_data})
The_world (stop)
The_world (force)
The_world (start)
gc_unpin ({pinned_data})
math_run array_sum(pinned_data) = ? -int64
