#% ------------------------------------------------------------
#% 15. 执行块 execute：father 复制上下文、start(normal/loop)、dog 状态白名单
#% 执行块在独立 Context 里跑；father = up 只把父上下文复制进去，块内改动不写回
#% ------------------------------------------------------------
math_run 5 = ? -int64
if up = (ok) goto (push ({seed} = {(in = up)}))

call = (execute)
father = up
start(normal) = {doubler}
{
    math_run {seed} * 2 = ?
    if up = (ok) goto (push ({seed} = {(in = up)}))
    print (<{"block local seed="} (and) {seed}>)
}
dog(doubler) = (pass : ok) (error : error)
print (<{"outer seed kept="} (and) {seed}>)

#% start(loop) 反复执行，直到块内 goto (to = stop)；它不能出现在执行块之外
start(loop) = {walker}
{
    math_run 7 + 1 = ? -int64
    if up = (ok) goto (push ({spin} = {(in = up)}))
    print (<{"loop spin="} (and) {spin}>)
    if up {spin} = (8) goto (to = stop)
}
dog(walker) = (pass : ok) (stop : stop)

#% ------------------------------------------------------------
#% 16. atom 原子块：lock / proton / nuclear_reactor / neutron
#% ------------------------------------------------------------
#atom
call = (atom)
push ({stage} = {"0"})

father = up
start(normal) = {stage_one}
{
    lock {stage_one}
    {
        math_run 10 + 1 = ? -int64
        if up = (ok) goto (push ({stage} = {(in = up)}))
    }
}
father = up
start(normal) = {stage_two}
{
    lock {stage_two}
    {
        math_run {stage} + 11 = ? -int64
        if up = (ok) goto (push ({stage} = {(in = up)}))
    }
}
neutron {stage_two} = {stage_one}
proton {pipeline} = {stage_one} -> {stage_two}
nuclear_reactor {main} = {pipeline}
dog(stage_two) = (pass : ok) (error : error)
print (<{"atom stage="} (and) {stage}>)

