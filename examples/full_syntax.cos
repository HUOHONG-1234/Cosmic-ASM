print (<{"HOP upper_text = "} (and) {英文大写}>)
print (<{"HOP find_index(beta) = "} (and) {英文位置}>)

array hop_numbers = [3, 1, 2]
数组求和 hop_numbers 存 hop_total
数组长度 hop_numbers 存 hop_count
平方根 81 存 hop_root
print (<{"HOP 数组求和 = "} (and) {hop_total} (and) {" 数组长度 = "} (and) {hop_count}>)
print (<{"HOP 平方根(81) = "} (and) {hop_root}>)

require_ok 1

