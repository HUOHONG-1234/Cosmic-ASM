push ({inv3} = matrix3_inverse([[1, 0, 0], [0, 1, 0], [0, 0, 1]]))
math_run matrix_at({inv3}, 2, 2) = ? -float64
if up = (ok) goto (push ({inv3_22} = {(in = up)}))
print (<{"3x3 identity inverse (2,2)="} (and) {inv3_22}>)

#% solve_linear(A, b) 解 Ax=b，返回普通数组
push ({solution} = solve_linear([[1, 1], [2, 3]], [3, 8]))
math_run array_at({solution}, 0) = ? -float64
