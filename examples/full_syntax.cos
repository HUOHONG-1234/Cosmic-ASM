#% ------------------------------------------------------------
#% 4. 函数：四种写法
#%   function f(a, b) = 表达式                单表达式（可递归）
#%   function f(a, b) { let/set/if/while/... } 语句体
#%   function f(a) = ... 写在函数体内          嵌套函数（按值捕获外层）
#%   generic function f(a, b) = 表达式         泛型（按实参类型工作）
#% choose(条件, 真值, 假值) 惰性选择分支
#% ------------------------------------------------------------
#% 名字用 fact_rec，避免和后面 #%include 进来的 lib/math.cos 里的 factorial 冲突
function fact_rec(n) = choose(n <= 1, 1, n * fact_rec(n - 1))
math_run fact_rec(10) = ? -int64
if up = (ok) goto (push ({fact10} = {(in = up)}))
print (<{"fact_rec(10)="} (and) {fact10}>)

generic function combine(a, b) = a + b
math_run combine(2, 3) = ? -int64
if up = (ok) goto (push ({gint} = {(in = up)}))
print (<{"generic int 2+3="} (and) {gint}>)

#% 语句体：let 声明局部量、set 赋值、if/else、while、break、continue、return
function sum_odds(limit)
{
    let total = 0
    let i = 0
    while (i < limit)
    {
        set i = i + 1
        if (i % 2 == 0)
        {
            continue
        }
        if (i > limit - 1)
        {
            break
        }
        set total = total + i
    }
    return total
}
math_run sum_odds(10) = ? -int64
if up = (ok) goto (push ({odds} = {(in = up)}))
print (<{"sum_odds(10)="} (and) {odds}>)

#% 函数体内的 if 要求 else 分支存在，且两个分支都以 return 结束
function pick_label(score)
{
    if (score >= 90)
    {
        return 3
    }
    else
    {
        if (score >= 60)
        {
            return 2
        }
        else
        {
            return 1
        }
    }
}
math_run pick_label(75) = ? -int64
if up = (ok) goto (push ({label75} = {(in = up)}))
math_run pick_label(95) = ? -int64
if up = (ok) goto (push ({label95} = {(in = up)}))
print (<{"label(75)="} (and) {label75} (and) {" label(95)="} (and) {label95}>)

#% 嵌套函数：按值捕获外层参数与局部量（改动外层不影响已捕获的副本）
function closure_demo(seed)
{
    let factor = 2
    function apply(value) = value * factor + seed
    let first = apply(3)
    set factor = 10
    let second = apply(3)
    return first * 100 + second
}
math_run closure_demo(5) = ? -int64
if up = (ok) goto (push ({captured} = {(in = up)}))
print (<{"closure first*100+second="} (and) {captured}>)

#% ------------------------------------------------------------
#% 5. 文本参数与文本返回（v9）
#% function greet(name : text) -> text = upper(name)   显式标注
#% function shout(word) = upper(word)                   不标注时按用法推断
#% 花括号写法 {name} 与裸名等价
#% ------------------------------------------------------------
function greet(name : text) -> text = upper(name)
function shout(word) = upper(word)
function greet_braced(name : text) -> text = upper({name})
math_run greet("cosmic") = ?
if up = (ok) goto (push ({g1} = {(in = up)}))
math_run shout("loud") = ?
if up = (ok) goto (push ({g2} = {(in = up)}))
math_run greet_braced("braces") = ?
if up = (ok) goto (push ({g3} = {(in = up)}))
print (<{g1} (and) {" "} (and) {g2} (and) {" "} (and) {g3}>)

function measure(text_value : text) = strlen(text_value)
math_run measure("abcd") = ? -int64
if up = (ok) goto (push ({measured} = {(in = up)}))
print (<{"measure(\"abcd\")="} (and) {measured}>)

#% v10 文本拼接内置：text_concat / to_text / text_join
function build_list(times) -> text
{
    let acc = ""
    let i = 1
    while (i <= times)
    {
        let piece = text_concat("item", to_text(i))
        if (i > 1)
        {
            set acc = text_concat(acc, ",")
        }
        set acc = text_concat(acc, piece)
        set i = i + 1
    }
    return acc
}
math_run build_list(3) = ?
if up = (ok) goto (push ({listing} = {(in = up)}))
print (<{"build_list(3)="} (and) {listing}>)

math_run text_join([10, 20, 30], " / ") = ?
if up = (ok) goto (push ({joined} = {(in = up)}))
print (<{"text_join="} (and) {joined}>)

#% ------------------------------------------------------------
#% 6. 数组参数与数组返回（v9）
#% ------------------------------------------------------------
function total(values : array) = array_sum(values)
function build_array(size) = array_fill(size, 7)
math_run total([1, 2, 3, 4]) = ? -int64
if up = (ok) goto (push ({arr_total} = {(in = up)}))
