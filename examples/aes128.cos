if up = (ok) goto (push ({t15} = {(in = up)}))
push ({s0} = {t0})
push ({s1} = {t1})
push ({s2} = {t2})
push ({s3} = {t3})
push ({s4} = {t4})
push ({s5} = {t5})
push ({s6} = {t6})
push ({s7} = {t7})
push ({s8} = {t8})
push ({s9} = {t9})
push ({s10} = {t10})
push ({s11} = {t11})
push ({s12} = {t12})
push ({s13} = {t13})
push ({s14} = {t14})
push ({s15} = {t15})

#% MixColumns
math_run xt({s0}) ^ (xt({s1}) ^ {s1}) ^ {s2} ^ {s3} = ?
if up = (ok) goto (push ({m0_0} = {(in = up)}))
math_run {s0} ^ xt({s1}) ^ (xt({s2}) ^ {s2}) ^ {s3} = ?
if up = (ok) goto (push ({m0_1} = {(in = up)}))
math_run {s0} ^ {s1} ^ xt({s2}) ^ (xt({s3}) ^ {s3}) = ?
if up = (ok) goto (push ({m0_2} = {(in = up)}))
math_run (xt({s0}) ^ {s0}) ^ {s1} ^ {s2} ^ xt({s3}) = ?
if up = (ok) goto (push ({m0_3} = {(in = up)}))
push ({s0} = {m0_0})
push ({s1} = {m0_1})
push ({s2} = {m0_2})
push ({s3} = {m0_3})
math_run xt({s4}) ^ (xt({s5}) ^ {s5}) ^ {s6} ^ {s7} = ?
if up = (ok) goto (push ({m1_0} = {(in = up)}))
math_run {s4} ^ xt({s5}) ^ (xt({s6}) ^ {s6}) ^ {s7} = ?
if up = (ok) goto (push ({m1_1} = {(in = up)}))
math_run {s4} ^ {s5} ^ xt({s6}) ^ (xt({s7}) ^ {s7}) = ?
if up = (ok) goto (push ({m1_2} = {(in = up)}))
math_run (xt({s4}) ^ {s4}) ^ {s5} ^ {s6} ^ xt({s7}) = ?
if up = (ok) goto (push ({m1_3} = {(in = up)}))
push ({s4} = {m1_0})
push ({s5} = {m1_1})
push ({s6} = {m1_2})
push ({s7} = {m1_3})
math_run xt({s8}) ^ (xt({s9}) ^ {s9}) ^ {s10} ^ {s11} = ?
if up = (ok) goto (push ({m2_0} = {(in = up)}))
math_run {s8} ^ xt({s9}) ^ (xt({s10}) ^ {s10}) ^ {s11} = ?
if up = (ok) goto (push ({m2_1} = {(in = up)}))
math_run {s8} ^ {s9} ^ xt({s10}) ^ (xt({s11}) ^ {s11}) = ?
if up = (ok) goto (push ({m2_2} = {(in = up)}))
math_run (xt({s8}) ^ {s8}) ^ {s9} ^ {s10} ^ xt({s11}) = ?
if up = (ok) goto (push ({m2_3} = {(in = up)}))
push ({s8} = {m2_0})
push ({s9} = {m2_1})
push ({s10} = {m2_2})
push ({s11} = {m2_3})
math_run xt({s12}) ^ (xt({s13}) ^ {s13}) ^ {s14} ^ {s15} = ?
if up = (ok) goto (push ({m3_0} = {(in = up)}))
math_run {s12} ^ xt({s13}) ^ (xt({s14}) ^ {s14}) ^ {s15} = ?
if up = (ok) goto (push ({m3_1} = {(in = up)}))
math_run {s12} ^ {s13} ^ xt({s14}) ^ (xt({s15}) ^ {s15}) = ?
if up = (ok) goto (push ({m3_2} = {(in = up)}))
math_run (xt({s12}) ^ {s12}) ^ {s13} ^ {s14} ^ xt({s15}) = ?
if up = (ok) goto (push ({m3_3} = {(in = up)}))
push ({s12} = {m3_0})
push ({s13} = {m3_1})
push ({s14} = {m3_2})
push ({s15} = {m3_3})

#% AddRoundKey
math_run {s0} ^ bytes_get(RK, 32) = ?
if up = (ok) goto (push ({s0} = {(in = up)}))
math_run {s1} ^ bytes_get(RK, 33) = ?
if up = (ok) goto (push ({s1} = {(in = up)}))
