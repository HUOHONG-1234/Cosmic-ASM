#%固定四个整数的冒泡排序示例
#%当前语言还没有数组下标或动态磁带写入，因此用四个变量表示数组元素
#%输入为 4, 1, 3, 2；每轮比较相邻元素并在逆序时交换
#%math = int32
#math
call = (math)

math_run 4 = ? -int32
if up = (ok) goto (push ({a} = {(in = up)}))
math_run 1 = ? -int32
if up = (ok) goto (push ({b} = {(in = up)}))
math_run 3 = ? -int32
if up = (ok) goto (push ({c} = {(in = up)}))
math_run 2 = ? -int32
if up = (ok) goto (push ({d} = {(in = up)}))

#%第一轮：比较 a-b、b-c、c-d
if ({a} > {b})
{
    math_run {a} = ? -int32
    if up = (ok) goto (push ({temp} = {(in = up)}))
    math_run {b} = ? -int32
    if up = (ok) goto (push ({a} = {(in = up)}))
    math_run {temp} = ? -int32
    if up = (ok) goto (push ({b} = {(in = up)}))
}
if ({b} > {c})
{
    math_run {b} = ? -int32
    if up = (ok) goto (push ({temp} = {(in = up)}))
    math_run {c} = ? -int32
    if up = (ok) goto (push ({b} = {(in = up)}))
    math_run {temp} = ? -int32
    if up = (ok) goto (push ({c} = {(in = up)}))
}
if ({c} > {d})
{
    math_run {c} = ? -int32
    if up = (ok) goto (push ({temp} = {(in = up)}))
    math_run {d} = ? -int32
    if up = (ok) goto (push ({c} = {(in = up)}))
    math_run {temp} = ? -int32
    if up = (ok) goto (push ({d} = {(in = up)}))
}

#%第二轮：最大值已在 d，只需比较 a-b、b-c
if ({a} > {b})
{
    math_run {a} = ? -int32
    if up = (ok) goto (push ({temp} = {(in = up)}))
    math_run {b} = ? -int32
    if up = (ok) goto (push ({a} = {(in = up)}))
    math_run {temp} = ? -int32
    if up = (ok) goto (push ({b} = {(in = up)}))
}
if ({b} > {c})
{
    math_run {b} = ? -int32
    if up = (ok) goto (push ({temp} = {(in = up)}))
    math_run {c} = ? -int32
    if up = (ok) goto (push ({b} = {(in = up)}))
    math_run {temp} = ? -int32
    if up = (ok) goto (push ({c} = {(in = up)}))
}

#%第三轮：最后比较 a-b
if ({a} > {b})
{
    math_run {a} = ? -int32
    if up = (ok) goto (push ({temp} = {(in = up)}))
    math_run {b} = ? -int32
    if up = (ok) goto (push ({a} = {(in = up)}))
    math_run {temp} = ? -int32
    if up = (ok) goto (push ({b} = {(in = up)}))
}

