#% ============================================================
#% Cosmic ASM 全语法示例（v1 → v10）
#%
#% 这个文件把当前语言支持的全部语法各演示一遍，解释器与 GCC 编译版输出一致：
#%     python -m cosmic_interpreter.cosmic_cli run   examples/full_syntax.cos
#%     python -m cosmic_interpreter.cosmic_cli build examples/full_syntax.cos -o full_syntax
#%
#% 有三类语法无法塞进同一个可运行文件，写在 examples/full_syntax_platform.cos 与
#% 本文件末尾的注释里：#dll（仅 Windows + 需要链接系统库）、#%asm（仅编译版）、
#% 以及 #%target / #%features / #%memory 这类「整个程序只能选一个值」的声明。
#% ============================================================

#% 导入组件：execute 提供执行块与 bash，math 提供 math_run（v1 起）
#execute
#math

#% 全局数值模式，每个程序只能声明一次；单条 math_run 可用 -模式 覆盖
#%math = float64
#% 输出有效数字（1..17，默认 15），只影响显示
#%precision = 12

#% 指定某个变量永远以 GBK 存储（v1 起）
#hello = GBK

#% ------------------------------------------------------------
#% 1. 变量、字符串拼接与打印
#% var name = {"初始文本"} 显式声明并初始化字符串变量
#% {"text"} 是字符串字面量（支持 \n \" 转义）；{name} 才是变量引用
#% push ({name} = ...) 未声明时自动创建；push 里用 (and) 连接片段
#% print (<...>) 输出；-GBK 指定该行的输出编码
#% ------------------------------------------------------------
var greeting = {"hello"}
push ({who} = {"cosmic"})
push ({banner} = {greeting} (and) {" "} (and) {who})
print (<{banner}>)
push ({quoted} = {"say \"hi\"\nsecond line"})
print (<{quoted}>)
print (<{"literal {braces} stay literal"}>)

#% 编码：变量声明为 GBK 后，print 用 -GBK 把它按 GBK 输出
push ({legacy} = {"gbk-text"})
print (<{legacy}>) -GBK

#% kill{变量} -force 覆盖并释放该变量的本地存储（内存卫生，不是安全加固）
push ({victim} = {"secret"})
kill{victim} -force

#% 打印未定义/已 kill 的变量：静默失败，状态置为 error，并计入 err_count()
print (<{victim}>)
print (<{never_defined}>)
math_run err_count() = ? -int64
if up = (ok) goto (push ({errors} = {(in = up)}))
print (<{"err_count = "} (and) {errors}>)

#% ------------------------------------------------------------
#% 2. 数值：math_run 与各模式覆盖
#% math_run 表达式 = ? 把结果写进「上一行状态」，再用 if up = (ok) 取出来
#% 模式覆盖：-int32 -int64 -uint32 -float64 -complex -bigint
#% 科学函数：abs sqrt sin cos tan asin acos atan atan2 sinh cosh tanh exp
#%          log log10 log2 floor ceil pow fmod hypot erf erfc gamma lgamma beta zeta
#% 常数：pi e tau；三角函数用弧度
#% 每条 print 的片段都要写成 {"字面量"} 或 {变量}，中间用 (and) 连接
#% ------------------------------------------------------------
math_run sin(pi / 2) + sqrt(9) = ? -float64
if up = (ok) goto (push ({science} = {(in = up)}))
print (<{"sin(pi/2)+sqrt(9) = "} (and) {science}>)

math_run 16 * atan(1 / 5) - 4 * atan(1 / 239) = ? -float64
if up = (ok) goto (push ({machin} = {(in = up)}))
print (<{"machin formula = "} (and) {machin}>)

math_run hypot(3, 4) = ? -float64
if up = (ok) goto (push ({hyp} = {(in = up)}))
math_run fmod(7, 3) = ? -float64
if up = (ok) goto (push ({rem} = {(in = up)}))
math_run pow(2, 10) = ? -float64
if up = (ok) goto (push ({pw} = {(in = up)}))
print (<{"hypot="} (and) {hyp} (and) {" fmod="} (and) {rem} (and) {" pow="} (and) {pw}>)

math_run gamma(5) = ? -float64
if up = (ok) goto (push ({gam} = {(in = up)}))
math_run lgamma(5) = ? -float64
if up = (ok) goto (push ({lgam} = {(in = up)}))
math_run erfc(0) = ? -float64
if up = (ok) goto (push ({erfc0} = {(in = up)}))
math_run beta(2, 3) = ? -float64
if up = (ok) goto (push ({b23} = {(in = up)}))
math_run zeta(2) = ? -float64
if up = (ok) goto (push ({z2} = {(in = up)}))
print (<{"gamma(5)="} (and) {gam} (and) {" lgamma(5)="} (and) {lgam}>)
print (<{"erfc(0)="} (and) {erfc0} (and) {" beta(2,3)="} (and) {b23}>)
print (<{"zeta(2)="} (and) {z2}>)

#% int32 / int64：结果必须是整数且在范围内，否则报错
math_run 7 // 2 = ? -int32
if up = (ok) goto (push ({idiv} = {(in = up)}))
math_run 7 % 2 = ? -int32
if up = (ok) goto (push ({imod} = {(in = up)}))
math_run 2 ** 62 = ? -int64
if up = (ok) goto (push ({big_pow} = {(in = up)}))
print (<{"7//2="} (and) {idiv} (and) {" 7%2="} (and) {imod} (and) {" 2^62="} (and) {big_pow}>)

#% 位运算只能在整数模式下使用
math_run 12 & 10 = ? -int64
if up = (ok) goto (push ({band} = {(in = up)}))
math_run 12 | 10 = ? -int64
if up = (ok) goto (push ({bor} = {(in = up)}))
math_run 12 ^ 10 = ? -int64
if up = (ok) goto (push ({bxor} = {(in = up)}))
math_run 1 << 10 = ? -int64
if up = (ok) goto (push ({shl} = {(in = up)}))
math_run ~5 = ? -int64
if up = (ok) goto (push ({inv} = {(in = up)}))
print (<{"12&10="} (and) {band} (and) {" 12|10="} (and) {bor} (and) {" 12^10="} (and) {bxor}>)
print (<{"1<<10="} (and) {shl} (and) {" ~5="} (and) {inv}>)

#% uint32：结果按 2^32 回绕，>> 恒为逻辑右移
math_run 4294967295 + 2 = ? -uint32
if up = (ok) goto (push ({wrap} = {(in = up)}))
math_run 4294967295 >> 1 = ? -uint32
if up = (ok) goto (push ({lshr} = {(in = up)}))
print (<{"uint32 wrap="} (and) {wrap} (and) {" logical-shift="} (and) {lshr}>)

#% bigint：任意精度整数（上限 1,000,000 位）
math_run 2 ** 100 = ? -bigint
if up = (ok) goto (push ({huge} = {(in = up)}))
print (<{"2^100="} (and) {huge}>)

#% complex：double 精度复数；实部+虚部i 输出
math_run complex(1, 2) * complex(3, 4) = ? -complex
if up = (ok) goto (push ({prod} = {(in = up)}))
math_run real({prod}) = ? -complex
if up = (ok) goto (push ({pre} = {(in = up)}))
math_run imag({prod}) = ? -complex
if up = (ok) goto (push ({pim} = {(in = up)}))
math_run cabs(complex(3, 4)) = ? -float64
if up = (ok) goto (push ({modulus} = {(in = up)}))
math_run conj(complex(1, 2)) = ? -complex
if up = (ok) goto (push ({conj1} = {(in = up)}))
print (<{"(1+2i)(3+4i)="} (and) {prod} (and) {" real="} (and) {pre} (and) {" imag="} (and) {pim}>)
print (<{"cabs(3+4i)="} (and) {modulus} (and) {" conj(1+2i)="} (and) {conj1}>)

#% hex/unhex：十六进制文本与数值互转（unhex 建议配 bigint）
math_run hex(255, 4) = ? -int64
if up = (ok) goto (push ({hexed} = {(in = up)}))
print (<{"hex(255,4)="} (and) {hexed}>)
math_run unhex({"ff"}) = ? -bigint
if up = (ok) goto (push ({unhexed} = {(in = up)}))
print (<{"unhex(ff)="} (and) {unhexed}>)

#% 定点常数：小数点后 n 位的缩放整数，以及格式化好的十进制文本
math_run pi_digits(10) = ? -bigint
if up = (ok) goto (push ({pi_scaled} = {(in = up)}))
math_run pi_str(20) = ? -bigint
if up = (ok) goto (push ({pi_text} = {(in = up)}))
math_run e_str(10) = ? -bigint
if up = (ok) goto (push ({e_text} = {(in = up)}))
math_run sqrt2_str(10) = ? -bigint
if up = (ok) goto (push ({sqrt2_text} = {(in = up)}))
math_run e_digits(5) = ? -bigint
if up = (ok) goto (push ({e_scaled} = {(in = up)}))
math_run sqrt2_digits(5) = ? -bigint
if up = (ok) goto (push ({sqrt2_scaled} = {(in = up)}))
print (<{"pi_digits(10)="} (and) {pi_scaled}>)
print (<{"pi_str(20)="} (and) {pi_text}>)
print (<{"e_str(10)="} (and) {e_text} (and) {" sqrt2_str(10)="} (and) {sqrt2_text}>)
print (<{"e_digits(5)="} (and) {e_scaled} (and) {" sqrt2_digits(5)="} (and) {sqrt2_scaled}>)

#% rag (max : 上界) (min : 下界)：闭区间整数（模拟用，不是密码学随机数）
#% 这里把上下界都设成 1，让示例输出可复现；写 rag (max : 6) (min : 1) 就是掷骰子
math_run rag (max : 1) (min : 1) = ? -int32
if up = (ok) goto (push ({dice} = {(in = up)}))
print (<{"rag(1..1) = "} (and) {dice}>)

#% Unicode：chr(码点) / ord(字符)；strlen 按码点计数，char_at 取下标字符
push ({ch} = {"你"})
math_run ord({ch}) = ? -int32
if up = (ok) goto (push ({code} = {(in = up)}))
print (<{"ord(\u4f60)="} (and) {code}>)
math_run chr({code}) = ?
if up = (ok) goto (push ({back} = {(in = up)}))
print (<{"chr back = "} (and) {back}>)
math_run strlen({ch}) = ? -int64
if up = (ok) goto (push ({len1} = {(in = up)}))
math_run char_at({"abc"}, 1) = ?
if up = (ok) goto (push ({at1} = {(in = up)}))
print (<{"strlen="} (and) {len1} (and) {" char_at(abc,1)="} (and) {at1}>)

#% ------------------------------------------------------------
#% 3. 数组、字节数组、矩阵与统计
#% array name = [..] 声明具名数组（索引从 0 开始，跨 math_run 保留）
#% array_set/array_push 原地改具名数组；列表字面量则产生临时数组
#% bytes name = [..] 声明字节数组，元素必须 0..255
#% 矩阵写作嵌套列表，形状随值保存；矩阵值不能 print，必须交给矩阵函数
#% ------------------------------------------------------------
array scores = [1, 2, 3]
math_run array_len(scores) = ? -int64
if up = (ok) goto (push ({n_scores} = {(in = up)}))
math_run array_sum(scores) = ? -int64
if up = (ok) goto (push ({sum_scores} = {(in = up)}))
math_run array_at(scores, 1) = ? -int64
if up = (ok) goto (push ({second} = {(in = up)}))
print (<{"len="} (and) {n_scores} (and) {" sum="} (and) {sum_scores} (and) {" at(1)="} (and) {second}>)

math_run array_sum(array_push(scores, 4)) = ? -int64
if up = (ok) goto (push ({pushed} = {(in = up)}))
math_run array_sum(array_set(scores, 0, 10)) = ? -int64
if up = (ok) goto (push ({setted} = {(in = up)}))
print (<{"after push="} (and) {pushed} (and) {" after set="} (and) {setted}>)

array unsorted = [5, 1, 9, 3]
array ordered = sort_array(unsorted)
array reversed_arr = reverse_array(unsorted)
math_run array_at(ordered, 0) = ? -int64
if up = (ok) goto (push ({smallest} = {(in = up)}))
math_run array_at(reversed_arr, 0) = ? -int64
if up = (ok) goto (push ({last_one} = {(in = up)}))
math_run array_index_of(unsorted, 9) = ? -int64
if up = (ok) goto (push ({found_at} = {(in = up)}))
print (<{"sorted[0]="} (and) {smallest} (and) {" reversed[0]="} (and) {last_one} (and) {" index_of(9)="} (and) {found_at}>)

#% 统计与积分：返回小数，用 -float64
math_run dot([1, 2, 3], [4, 5, 6]) = ? -float64
if up = (ok) goto (push ({dp} = {(in = up)}))
