#% 巴塞尔问题: sum 1/n^2 = pi^2/6
#math
call = (math)

math_run 0 = ? -float64
if up = (ok) goto (push ({sum} = {(in = up)}))
math_run 1 = ? -float64
if up = (ok) goto (push ({n} = {(in = up)}))
while ({n} < 1000000)
{
    math_run {sum} + 1 / ({n} * {n}) = ? -float64
    if up = (ok) goto (push ({sum} = {(in = up)}))
    math_run {n} + 1 = ? -float64
    if up = (ok) goto (push ({n} = {(in = up)}))
}
print (<{sum}>)
math_run {sum} * 6 = ? -float64
if up = (ok) goto (push ({six_sum} = {(in = up)}))
print (<{six_sum}>)
math_run sqrt({six_sum}) = ? -float64
if up = (ok) goto (push ({pi_est} = {(in = up)}))
print (<{pi_est}>)
